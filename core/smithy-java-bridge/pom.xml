<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <groupId>software.amazon.awssdk</groupId>
        <version>2.46.11-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>smithy-java-bridge</artifactId>
    <name>AWS Java SDK :: Core :: Smithy-Java Bridge</name>
    <description>
        Adapters that let the AWS SDK for Java v2 public surface run on the smithy-java
        runtime: v2 ExecutionInterceptor &lt;-&gt; smithy-java ClientInterceptor, and
        v2 SdkHttpClient -&gt; smithy-java ClientTransport. Experimental.
    </description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.bridge.smithyjava</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- v2 SPIs the bridges adapt. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-client-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- sdk-core: SdkPojo / SdkField / MarshallingType for the v2->smithy struct adapter. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>utils</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>annotations</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- aws-core: AwsClientOption / AwsExecutionAttribute / AwsServiceException, read by the
             config, endpoint, and error bridges. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- retries-spi: the v2 RetryStrategy handed to smithy-java's SdkRetryStrategy adapter. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>retries-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- identity-spi / http-auth-spi: the credentials provider and SelectedAuthScheme the v2
             endpoint rules engine expects. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- v2's own SigV4 signer and checksum algorithms, for V2SignerBridge: S3's flexible checksums,
             aws-chunked trailers, chunked signing and UNSIGNED-PAYLOAD all live in v2's signer, and
             smithy-java 1.6.1 implements none of them. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>checksums</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>

        <!-- smithy-java runtime the bridges target. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-http</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>http-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>context</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>io</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>endpoints</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>auth-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>retries-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>retries</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- AWS-specific smithy-java pieces: the credentials identity type, SigV4, the AWS JSON
             protocol, and the adapter that lets a v2 RetryStrategy drive smithy's retry loop. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-auth-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-sigv4</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-awsjson</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- rest-xml, for S3. The protocol class is a thin HttpBindingClientProtocol subclass; the
             XML reading and writing lives in xml-codec, and the request-line/header/query/label
             binding in http-binding. Maven Central's search index still lists these at 0.0.x, but
             ${smithy.java.version} is published; check maven-metadata.xml, not the search UI. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-restxml</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>xml-codec</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>http-binding</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-sdkv2-retries</artifactId>
            <version>${smithy.java.version}</version>
            <exclusions>
                <!-- aws-sdkv2-retries pins a released retries-spi; this build must use the local
                     ${awsjavasdk.version} so that the v2 RetryStrategy types match the ones the rest
                     of the SDK compiles against. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>retries-spi</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- smithy-model: HttpPayloadTrait, for choosing the zero-alloc payload write path. -->
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-model</artifactId>
            <version>${smithy.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
