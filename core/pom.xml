<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>aws-sdk-java-pom</artifactId>
        <groupId>software.amazon.awssdk</groupId>
        <version>2.55.13-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <name>AWS Java SDK :: Core</name>
    <packaging>pom</packaging>
    <description>
        The AWS SDK for Java - Core is an umbrella module that contains child modules which are considered as
        core of the library.
    </description>

    <modules>
        <module>annotations</module>
        <module>arns</module>
        <module>auth</module>
        <module>identity-spi</module>
        <module>http-auth-spi</module>
        <module>http-auth</module>
        <module>http-auth-aws</module>
        <module>http-auth-aws-crt</module>
        <module>http-auth-aws-eventstream</module>
        <module>auth-crt</module>
        <module>sdk-core</module>
        <module>aws-core</module>
        <module>profiles</module>
        <module>regions</module>
        <module>protocols</module>
        <module>metrics-spi</module>
        <module>json-utils</module>
        <module>endpoints-spi</module>
        <module>imds</module>
        <module>crt-core</module>
        <module>retries-spi</module>
        <module>retries</module>
        <module>checksums-spi</module>
        <module>checksums</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Generates META-INF/software.amazon.awssdk/<artifactId>/version.properties into
             generated-resources/sdk-resources, which the parent pom adds as a resource root. Build tooling reads the SDK
             version from this output directory and from the jar, so do not change the output directory, resource path,
             or key without coordinating with that tooling. Activated per module, so the aggregator poms are skipped. -->
        <profile>
            <id>generate-version-properties</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-version-properties</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/generated-resources/sdk-resources/META-INF/software.amazon.awssdk/${project.artifactId}</outputDirectory>
                                    <overwrite>true</overwrite>
                                    <resources>
                                        <resource>
                                            <directory>${maven.multiModuleProjectDirectory}/core/src/main/templates</directory>
                                            <includes>
                                                <include>version.properties</include>
                                            </includes>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The resources plugin silently skips a template directory that does not resolve. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>require-version-properties</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <message>version.properties was not generated. Check that ${maven.multiModuleProjectDirectory}/core/src/main/templates/version.properties exists.</message>
                                            <files>
                                                <file>${project.build.directory}/generated-resources/sdk-resources/META-INF/software.amazon.awssdk/${project.artifactId}/version.properties</file>
                                            </files>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
