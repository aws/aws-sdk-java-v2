{
  "version": "1.2",
  "serviceId": "query",
  "parameters": {
    "Endpoint": {
      "type": "string",
      "builtIn": "SDK::Endpoint",
      "documentation": "Override the endpoint used to send this request"
    }
  },
  "rules": [
    {
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Endpoint"
            }
          ]
        }
      ],
      "endpoint": {
        "url": "{endpoint}",
        "properties": {
          "authSchemes": [
            {
              "name": "sigv4",
              "signingRegion": "us-east-1",
              "signingName": "query-service"
            }
          ]
        }
      },
      "type": "endpoint"
    },
    {
      "conditions": [],
      "endpoint": {
        "url": "https://query-service.us-east-1.amazonaws.com",
        "properties": {
          "authSchemes": [
            {
              "name": "sigv4",
              "signingRegion": "us-east-1",
              "signingName": "query-service"
            }
          ]
        }
      },
      "type": "endpoint"
    }
  ]
}
